generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  name           String?
  username       String?        @unique
  email          String?        @unique
  passwordHash   String?
  emailVerified  DateTime?
  image          String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  role           Role           @default(CLIENT)
  status         UserStatus     @default(ONBOARDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  staffRecords   Staff[]
  aiSessions     AiSession[]
  notifications  Notification[]

  @@index([email])
  @@index([role])
  @@index([organizationId])
}

model LoginAttempt {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
}

enum Role {
  ADMIN
  DJ
  CLIENT
}

enum UserStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  plan        String   @default("free")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  settings        OrganizationSettings?
  events          Event[]
  clients         Client[]
  vendors         Vendor[]
  venues          Venue[]
  staff           Staff[]
  services        Service[]
  payments        Payment[]
  musicSelections MusicSelection[]
  aiSessions      AiSession[]
  notifications   Notification[]
  importBatches   ImportBatch[]
}

model OrganizationSettings {
  id               String       @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String       @unique
  primaryColor     String       @default("24 95% 53%") /* Fredo orange */
  secondaryColor   String       @default("222.2 84% 4.9%") /* dark foreground */
  accentColor      String       @default("210 40% 98%") /* light foreground */
  backgroundColor  String       @default("0 0% 100%") /* white */
  logoUrl          String?
  faviconUrl       String?
  businessPhone    String?
  businessEmail    String?
  businessWebsite  String?
  brandAccentColor String       @default("#FF6B00")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Client {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  name            String
  pronunciation   String?
  role            String       @default("client")
  contactName     String
  email           String?
  phone           String?
  phoneType       String?      @default("mobile")
  address         String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  notes           String?
  photoUrl        String?
  photoStorageKey String?      @unique
  photoMimeType   String?
  companyType     String?      @default("individual")
  taxId           String?
  preferences     Json?
  status          String       @default("active")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  events             Event[]
  payments           Payment[]
  persons            ClientPerson[]
  additionalContacts ClientAdditionalContact[]
  phoneNumbers       ClientPhoneNumber[]       @relation("ClientPhoneNumbers")
}

model ClientPerson {
  id              String              @id @default(cuid())
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        String
  name            String
  pronunciation   String?
  role            String              @default("client")
  email           String?
  phone           String?
  phoneType       String?             @default("mobile")
  photoUrl        String?
  photoStorageKey String?             @unique
  photoMimeType   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  phoneNumbers    ClientPhoneNumber[] @relation("ClientPersonPhoneNumbers")

  @@index([clientId])
}

model ClientAdditionalContact {
  id            String              @id @default(cuid())
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  name          String
  pronunciation String?
  role          String
  phone         String?
  email         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  phoneNumbers  ClientPhoneNumber[] @relation("AdditionalContactPhoneNumbers")

  @@index([clientId])
}

model ClientPhoneNumber {
  id                  String                   @id @default(cuid())
  number              String
  type                String                   @default("mobile")
  clientId            String?
  personId            String?
  additionalContactId String?
  client              Client?                  @relation("ClientPhoneNumbers", fields: [clientId], references: [id], onDelete: Cascade)
  person              ClientPerson?            @relation("ClientPersonPhoneNumbers", fields: [personId], references: [id], onDelete: Cascade)
  additionalContact   ClientAdditionalContact? @relation("AdditionalContactPhoneNumbers", fields: [additionalContactId], references: [id], onDelete: Cascade)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([clientId])
  @@index([personId])
  @@index([additionalContactId])
  @@index([number])
}

model Venue {
  id                  String       @id @default(cuid())
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId      String
  name                String
  address             String?
  address2            String?
  city                String?
  state               String?
  postalCode          String?
  country             String?
  telephone           String?
  faxPhone            String?
  cellPhone           String?
  email               String?
  website             String?
  manager             String?
  directions          String?
  comments            String?
  xmlInfo             String?
  category            String?
  distance            String?
  travelTime          String?
  travelFee           String?
  setupFee            String?
  taxRate             String?
  needsApproval       Boolean      @default(false)
  excludeFromInfoForm Boolean      @default(false)
  oneTimeVenue        Boolean      @default(false)
  profileImageUrl     String?
  capacity            Int?
  features            Json?        @default("[]")
  hourlyRate          Decimal?     @default(0)
  status              String       @default("active")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  events   Event[]
  contacts VenueContact[]
  files    VenueFile[]
}

model VenueContact {
  id        String   @id @default(cuid())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId   String
  name      String
  phone     String?
  email     String?
  position  String?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

model VenueFile {
  id           String   @id @default(cuid())
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId      String
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([venueId, createdAt])
}

model Event {
  id                String       @id @default(cuid())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String
  client            Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId          String?
  name              String
  description       String?
  status            String       @default("planned") /* planned, confirmed, completed, cancelled */
  type              String       @default("event") /* event, wedding, corporate, etc. */
  startDateTime     DateTime
  endDateTime       DateTime
  timezone          String       @default("UTC")
  venue             Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  venueId           String?
  address           String?
  expectedAttendees Int?
  budget            Decimal?     @default(0)
  currency          String       @default("USD")
  coverImage        String?
  coverVideo        String?
  tags              Json?        @default("[]")
  notes             String?
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  staffAssignments  StaffAssignment[]
  vendorAssignments VendorAssignment[]
  timelines         Timeline[]
  payments          Payment[]
  musicSelections   MusicSelection[]
  calendarIcsPath   String?
  reminderSent      Boolean            @default(false)
  reminderDate      DateTime?
  eventServices     EventService[]
  aiSessions        AiSession[]
}

model Staff {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  name            String
  email           String?
  phone           String?
  specialty       String?      @default("dj")
  experienceLevel String?      @default("intermediate")
  status          String       @default("available")
  hourlyRate      Decimal?     @default(0)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  eventAssignments StaffAssignment[]
}

model StaffAssignment {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId    String
  role       String   @default("dj")
  assignedAt DateTime @default(now())
  status     String   @default("confirmed")
}

model Vendor {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  contactName    String
  email          String
  phone          String?
  category       String       @default("venue") /* venue, catering, equipment, etc. */
  status         String       @default("active")
  rating         Decimal?     @default(0)
  priceRange     String?
  website        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  eventAssignments VendorAssignment[]
}

model VendorAssignment {
  id          String   @id @default(cuid())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId    String
  serviceType String
  assignedAt  DateTime @default(now())
  status      String   @default("pending")
}

model Service {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  description    String?
  category       String       @default("standard") /* standard, premium, platinum */
  price          Decimal
  duration       Int?         @default(60) /* minutes */
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  eventServices EventService[]
}

model EventService {
  id              String   @id @default(cuid())
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId       String
  quantity        Int      @default(1)
  specialRequests String?
  createdAt       DateTime @default(now())
}

model Timeline {
  id          String   @id @default(cuid())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  title       String
  startTime   DateTime
  endTime     DateTime
  description String?
  order       Int
  isCollapsed Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps TimelineStep[]
}

model TimelineStep {
  id          String   @id @default(cuid())
  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  timelineId  String
  title       String
  time        DateTime
  description String?
  isCompleted Boolean  @default(false)
  order       Int
  createdAt   DateTime @default(now())
}

model Payment {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  event           Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId         String?
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId        String?
  amount          Decimal
  currency        String       @default("USD")
  status          String       @default("pending") /* pending, paid, failed, refunded */
  type            String       @default("payment") /* payment, deposit, refund, payout */
  stripePaymentId String?
  paymentDate     DateTime?
  dueDate         DateTime
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model MusicSelection {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId        String?
  title          String
  artist         String?
  album          String?
  duration       Int?
  filepath       String?
  type           String       @default("track") /* track, playlist, jingle */
  status         String       @default("selected") /* selected, approved, rejected */
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AiSession {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId        String?
  prompt         String
  response       Json?
  tokensUsed     Int?
  costUsd        Float?
  model          String       @default("gpt-4o")
  createdAt      DateTime     @default(now())
}

model Notification {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  type           String       @default("info") /* info, warning, error, reminder */
  title          String
  message        String
  actionUrl      String?
  isRead         Boolean      @default(false)
  actionLabel    String?
  createdAt      DateTime     @default(now())
}

model ImportBatch {
  id               String       @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String
  source           String       @default("djep") /* djep, csv, manual */
  fileName         String?
  status           String       @default("pending") /* pending, processing, completed, failed */
  totalRecords     Int          @default(0)
  processedRecords Int          @default(0)
  errorCount       Int          @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  rows             ImportRow[]
}

model ImportRow {
  id            String      @id @default(cuid())
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importBatchId String
  rawData       Json?
  mappedTo      String? /* model name */
  status        String      @default("pending") /* pending, success, failed */
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
