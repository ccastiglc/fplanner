
model AiUsage {
  id           String   @id @default(cuid())
  orgId        String   @default("fredo")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String?
  mode         String?
  provider     String?
  model        String?
  tool         String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  latencyMs    Int?
  contextHash  String?
  truncated    Boolean  @default(false)
  status       String?
  createdAt    DateTime @default(now())
}

model SettingsAudit {
  id           String   @id @default(cuid())
  orgId        String   @default("fredo")
  actorUserId  String
  actor        User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action       String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  orgId     String    @default("fredo")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
}

model ImportBatch {
  id         String      @id @default(cuid())
  orgId      String      @default("fredo")
  fileName   String?
  status     String?
  count      Int?
  createdBy  String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  rows       ImportRow[]
}

model ImportRow {
  id            String      @id @default(cuid())
  orgId         String      @default("fredo")
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  raw           Json?
  mapped        Json?
  errors        Json?
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
